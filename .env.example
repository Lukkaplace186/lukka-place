# Committed template. Copy to .env and fill in real values:
#   cp .env.example .env
PORT=3000
VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
APP_SECRET=
ALLOW_UNSIGNED_WEBHOOKS=
API_SECRET=
GRAPH_API_VERSION=v21.0

# Optional overrides — sensible defaults if left unset (services/db.js,
# services/mediaStorage.js). On a production host, point these at a
# persistent volume/mount rather than the app's own directory, so the local
# SQLite cache and downloaded photos survive a redeploy.
#   DB_PATH=/var/data/lukka_place.db
#   UPLOADS_DIR=/var/data/uploads

# Active pipeline — OpenAI + Chakra Chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Closing-price answers only (services/priceExtraction.js).
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_MAX_IMAGES=8
OPENAI_IMAGE_DETAIL=auto
# Photos sent with a written listing (>= 120 chars of text).
OPENAI_IMAGE_DETAIL_WITH_TEXT=low
CHAKRA_ACCESS_TOKEN=
CHAKRA_PLUGIN_ID=
CHAKRA_PHONE_NUMBER_ID=
CHAKRA_API_BASE=https://api.chakrahq.com
CHAKRA_WHATSAPP_API_VERSION=v21.0
CHAKRA_MEDIA_URL_TEMPLATE=
CHAKRA_MEDIA_TOKEN=
CHAKRA_MAX_MEDIA_BYTES=
GROUP_IDLE_MS=8000
GROUP_MAX_WAIT_MS=45000
# HMAC secret from the Chakra dashboard (Admin > Team > Secrets) — verifies
# the X-Chakra-Signature-256 header on every inbound webhook.
CHAKRA_WEBHOOK_HMAC_SECRET=

# Legacy pipeline — Gemini + direct Meta Cloud API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase Postgres — the database lukkaplace.com and its admin panel actually
# read from. A published listing is synced here (services/postgres.js); leave
# any of these unset to safely no-op the sync (e.g. in tests).
DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# Supabase Storage — uploads downloaded WhatsApp photos so featured_image /
# property_slider_images point at real public URLs (services/supabaseStorage.js).
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security — server-side only.
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=Property_images
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Automated agent matching (services/leadDispatch.js)
# ---------------------------------------------------------------------------
# Every customer request is ranked against the agencies covering its commune
# and pushed to the best seven on WhatsApp, the moment it is created.
#
# The template must exist and be APPROVED in Meta's WhatsApp Manager with five
# body variables, in this order:
#   {{1}} agent name   {{2}} commune   {{3}} bedrooms   {{4}} budget   {{5}} link
# Until it is approved, sends fall back to a plain session message, which
# reaches any agency that has messaged the engine in the last 24h.
# UNSET BY DEFAULT. This used to default to 'agent_lead_match', a name Meta
# has never heard of, so every dispatch paid a guaranteed-failing round trip
# PER AGENCY (seven per lead) to be told `(#132001) Template name does not
# exist in the translation`. Set it only once a template is genuinely
# approved; unset, the session fallback is used directly and quietly.
# AGENT_LEAD_MATCH_TEMPLATE=agent_lead_match
AGENT_LEAD_MATCH_TEMPLATE_LANG=fr
# The request alert WITH quick-reply buttons "Je m'en occupe" / "Pas dispo"
# (services/leadDispatch.js, matching in waves 2026-11-10). Draft to submit:
# docs/claude/whatsapp-delivery.md, "agent_lead_claim". Unset until Meta
# approves it; until then agencies outside their 24 h window get
# AGENT_LEAD_MATCH_TEMPLATE (no buttons) and claim from the dashboard link.
# AGENT_LEAD_CLAIM_TEMPLATE=agent_lead_claim
# Matching in waves: the every-minute sweep that sends wave 2 / wave 3 and
# hands unclaimed requests to the desk. off = pause it (wave 1 still goes).
# LEAD_WAVES=off

# ---------------------------------------------------------------------------
# Viewing-request notifications (services/viewingNotifications.js)
# ---------------------------------------------------------------------------
#
# Who hears about a "Demander une visite" submission. The listing's own agent
# is resolved automatically from Supabase (and only messaged when their number
# is phone-verified); this is the desk copy that also covers a request on a
# listing with no attributed agent.
#
# There is NO default, deliberately. The obvious candidate is the central
# number in web/'s NEXT_PUBLIC_WHATSAPP_NUMBER, and it is the wrong one: that
# IS this engine's own WhatsApp sender, and a WABA number cannot message
# itself. Set this to a real team handset (digits only, no '+'), or leave it
# unset and accept that a request on an unattributed listing reaches nobody.
# OPS_WHATSAPP_NUMBER=243XXXXXXXXX

# Optional, and unset by default like every other template name here now.
# Set it only once a template is genuinely approved.
#
# This one needs FIVE body variables and THREE quick-reply buttons:
#   {{1}} agent  {{2}} listing  {{3}} client  {{4}} requested time  {{5}} link
# The buttons carry the payloads `viewing_accept:<id>`,
# `viewing_reschedule:<id>` and `viewing_decline:<id>`. chakra.sendTemplate
# emits them as quick_reply components, and the payload comes back identically
# to the interactive path, so the feedback loop needs no change.
#
# Why it matters: sendInteractiveButtons is a SESSION message type, which Meta
# will not deliver outside the 24h window. Until this template is approved, an
# agent who has not messaged us recently receives neither the buttons nor the
# numbered fallback.
# VIEWING_REQUEST_TEMPLATE=
# VIEWING_REQUEST_TEMPLATE_LANG=fr

# ---------------------------------------------------------------------------
# Speed-to-lead (services/viewingSweeps.js, on scheduler.js's 60s tick)
# ---------------------------------------------------------------------------
# A viewing request an agent has not answered within 15 minutes escalates to
# OPS_WHATSAPP_NUMBER above and sends the customer real alternatives. Two
# hours after a confirmed visit, the customer is asked how it went.
#
# Two hours after a request the agent has not answered (after that
# escalation; never for one older than 24 h), the agent is asked "Avez-vous
# déjà contacté le client ?" (a direct chat from their own phone is invisible
# to us). VIEWING_CONTACT_CHECK=off stops asking; unset is on.
# VIEWING_CONTACT_CHECK=
#
# "Un client vous contacte" (services/contactTapAlert.js): when a visitor taps a
# verified agent's WhatsApp or Appeler button, that agent is told at once and
# asked whether they answered. A session message (24 h window). Off with:
# CONTACT_TAP_ALERT=off
#
# The check-in is CUSTOMER-facing, and a customer who arrived through the web
# form has never messaged this business number, so it reaches nobody until
# this template is approved. Two body variables ({{1}} client, {{2}} listing)
# and three quick-reply buttons carrying `visit_feedback_good:<id>`,
# `visit_feedback_bad:<id>` and `visit_feedback_noshow:<id>`.
# VISIT_FEEDBACK_TEMPLATE=
# VISIT_FEEDBACK_TEMPLATE_LANG=fr

# The decline survey, the reschedule prompt and the closing-price capture all
# reply through OPS_WHATSAPP_NUMBER above when they need a human to verify and
# archive a property an agent has told us is already let or sold.

# ---------------------------------------------------------------------------
# WhatsApp agent onboarding (services/agentOnboarding.js)
# ---------------------------------------------------------------------------
# How long the single-use activation ("magic") link stays valid. Long on
# purpose: the phone is already verified by the WhatsApp message itself, so
# this protects the password, not the number.
AGENT_ACTIVATION_TTL_HOURS=72

# ---------------------------------------------------------------------------
# Weekly customer alert sweep (services/scheduler.js)
# ---------------------------------------------------------------------------
# The engine is the only always-on single-instance process here, so it holds
# the timer and calls the storefront's own alert endpoint. Without CRON_SECRET
# the sweep refuses to run rather than calling an unauthenticated endpoint —
# it must match web/.env.local's CRON_SECRET exactly.
WEB_BASE_URL=https://lukkaplace.com
CRON_SECRET=
# Local-time day (0 = Sunday) and hour. Default: Monday 09:00.
SEARCH_ALERT_DAY=1
SEARCH_ALERT_HOUR=9
# Set to 'true' to stop the scheduler entirely (e.g. on a staging box that
# shares the production database and must not message real customers).
DISABLE_SCHEDULER=

# Absolute origin used to build agent-facing links (dashboard deep links in
# lead alerts, activation links). Falls back to https://lukkaplace.com.
PUBLIC_SITE_URL=https://lukkaplace.com

# ---------------------------------------------------------------------------
# Publish-time geocoding (services/geocoding.js)
# ---------------------------------------------------------------------------
# IP-restricted Google Maps key for THIS server (Geocoding API enabled). Fills
# properties.latitude/longitude when a listing syncs to Postgres, so the web
# map can filter by bounding box. NOT the storefront's
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY: that one is referrer-restricted and Google
# refuses it server-side. Unset = no coordinates are stored; the map places
# those listings at their commune centroid. Backfill older rows with
# `node scripts/backfill-listing-coordinates.js [--write]`.
# GOOGLE_MAPS_SERVER_KEY=

# Lukka Place's desk phone (services/opsDesk.js). Receives the desk copy of
# every viewing request, listing enquiry and ops alert. Set it with
# `node scripts/ops-desk.js set <number> --write`, never by hand-typing a local
# 08… number. The desk phone must message the business number at least once a
# day (the engine asks it to) or nothing reaches it — no template is approved.
OPS_WHATSAPP_NUMBER=

# "Annonce à valider" alerts (services/moderationAlerts.js): the owners' own
# phones, comma-separated, told once per listing that enters the approval
# queue, with a link to /admin/listings/<id>. Unset → the desk above.
# ADMIN_ALERT_NUMBERS=243812345678,243899999999
# UTILITY template, fr: body {{1}} listing number, {{2}} what + where,
# {{3}} agent; one DYNAMIC URL button https://lukkaplace.com/admin/listings/{{1}}.
# Unset → a session message (reaches a phone only inside its 24h window).
# MODERATION_ALERT_TEMPLATE=

# Visit-alert templates approved with the three QUICK-REPLY buttons
# (Accepter / Autre créneau / Décliner, in that order). A template listed here
# is sent with payloads viewing_accept|reschedule|decline:<id> instead of its
# link parameter, so the agent's tap answers the request. Comma list, read at
# call time. Unset = the alert keeps its link button.
# VIEWING_TEMPLATES_WITH_BUTTONS=demande_visite_agent_v3

# The customer's answer to an agent's new time (services/viewingSweeps.js):
# after 3 h of silence, one reminder and a desk alert, Kinshasa daytime only.
# VIEWING_PROPOSAL_FOLLOWUP=off disables it; unset is on. The proposal template
# with quick replies is listed in VIEWING_TEMPLATES_WITH_BUTTONS too.
# VIEWING_PROPOSAL_FOLLOWUP=

# Every WhatsApp message in and out is kept in whatsapp_message_log
# (services/messageLog.js). MESSAGE_LOG=off stops recording; unset is on.
# MESSAGE_LOG=

# "Faites le point sur vos annonces" (services/agentStatusCheck.js): one
# WhatsApp per agent every 14 days with a private link to update every
# listing. Same daily job and switch as the old per-listing check:
# AVAILABILITY_CHECK=off pauses it. The Meta template (UTILITY, fr, link
# button first, then the "Rien n'a changé" quick reply) is read at call
# time; without it only agents inside the 24h window get a session message.
# LISTING_STATUS_TEMPLATE=point_annonces_agent
# LISTING_STATUS_TEMPLATE_LANG=fr
# If Meta approves it with a picture header, add it to TEMPLATES_WITH_IMAGE.

# Auto-pause (services/listingAutoPause.js): OFF unless set to "on". Hides a
# listing unconfirmed for 30 days whose agent was asked and did not answer.
# LISTING_AUTO_PAUSE=on

# --- Lukka Place app: push alerts (services/pushNotify.js, 2026-11-10) ---
# Path to the Firebase service-account JSON (or the JSON itself). Unset: alerts
# are still recorded for the in-app inbox, but nothing is pushed — WhatsApp as before.
FCM_SERVICE_ACCOUNT=
# off = WhatsApp only, nothing recorded (kill switch).
PUSH_NOTIFY=
# Minutes before an unread urgent push (viewing request, enquiry) also goes on WhatsApp. Default 5.
PUSH_FALLBACK_MIN=
# Minutes before an unread urgent push to a CUSTOMER (visit, chat…) also goes on WhatsApp. Default 10.
PUSH_CUSTOMER_FALLBACK_MIN=
# Customer visit reminders, the evening before and 2 h before (services/customerAlerts.js). off = stopped.
VISIT_REMINDERS=
# Saved listings let / under offer / back on the market (services/favoriteStatus.js). off = stopped; hour in Kinshasa, default 11.
FAVORITE_STATUS=
FAVORITE_STATUS_HOUR=
# The 24 h "Un agent vous a-t-il contacté ?" follow-up (services/requestFollowup.js). off = stopped.
REQUEST_FOLLOWUP=
# Approved template suivi_demande_client (three quick replies). Unset: app push, else text inside the 24 h window only.
SUIVI_DEMANDE_TEMPLATE=
