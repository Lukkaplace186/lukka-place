# Committed template. Copy to .env and fill in real values:
#   cp .env.example .env
PORT=3000
VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
APP_SECRET=
ALLOW_UNSIGNED_WEBHOOKS=
API_SECRET=
GRAPH_API_VERSION=v21.0

# Optional overrides — sensible defaults if left unset (services/db.js,
# services/mediaStorage.js). On a production host, point these at a
# persistent volume/mount rather than the app's own directory, so the local
# SQLite cache and downloaded photos survive a redeploy.
#   DB_PATH=/var/data/lukka_place.db
#   UPLOADS_DIR=/var/data/uploads

# Active pipeline — OpenAI + Chakra Chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_IMAGES=8
OPENAI_IMAGE_DETAIL=auto
CHAKRA_ACCESS_TOKEN=
CHAKRA_PLUGIN_ID=
CHAKRA_PHONE_NUMBER_ID=
CHAKRA_API_BASE=https://api.chakrahq.com
CHAKRA_WHATSAPP_API_VERSION=v21.0
CHAKRA_MEDIA_URL_TEMPLATE=
CHAKRA_MEDIA_TOKEN=
CHAKRA_MAX_MEDIA_BYTES=
GROUP_IDLE_MS=8000
GROUP_MAX_WAIT_MS=45000
# HMAC secret from the Chakra dashboard (Admin > Team > Secrets) — verifies
# the X-Chakra-Signature-256 header on every inbound webhook.
CHAKRA_WEBHOOK_HMAC_SECRET=

# Legacy pipeline — Gemini + direct Meta Cloud API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase Postgres — the database lukkaplace.com and its admin panel actually
# read from. A published listing is synced here (services/postgres.js); leave
# any of these unset to safely no-op the sync (e.g. in tests).
DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# Supabase Storage — uploads downloaded WhatsApp photos so featured_image /
# property_slider_images point at real public URLs (services/supabaseStorage.js).
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security — server-side only.
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=Property_images
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Automated agent matching (services/leadDispatch.js)
# ---------------------------------------------------------------------------
# Every customer request is ranked against the agencies covering its commune
# and pushed to the best seven on WhatsApp, the moment it is created.
#
# The template must exist and be APPROVED in Meta's WhatsApp Manager with five
# body variables, in this order:
#   {{1}} agent name   {{2}} commune   {{3}} bedrooms   {{4}} budget   {{5}} link
# Until it is approved, sends fall back to a plain session message, which
# reaches any agency that has messaged the engine in the last 24h.
AGENT_LEAD_MATCH_TEMPLATE=agent_lead_match
AGENT_LEAD_MATCH_TEMPLATE_LANG=fr

# ---------------------------------------------------------------------------
# WhatsApp agent onboarding (services/agentOnboarding.js)
# ---------------------------------------------------------------------------
# How long the single-use activation ("magic") link stays valid. Long on
# purpose: the phone is already verified by the WhatsApp message itself, so
# this protects the password, not the number.
AGENT_ACTIVATION_TTL_HOURS=72

# ---------------------------------------------------------------------------
# Weekly customer alert sweep (services/scheduler.js)
# ---------------------------------------------------------------------------
# The engine is the only always-on single-instance process here, so it holds
# the timer and calls the storefront's own alert endpoint. Without CRON_SECRET
# the sweep refuses to run rather than calling an unauthenticated endpoint —
# it must match web/.env.local's CRON_SECRET exactly.
WEB_BASE_URL=https://lukkaplace.com
CRON_SECRET=
# Local-time day (0 = Sunday) and hour. Default: Monday 09:00.
SEARCH_ALERT_DAY=1
SEARCH_ALERT_HOUR=9
# Set to 'true' to stop the scheduler entirely (e.g. on a staging box that
# shares the production database and must not message real customers).
DISABLE_SCHEDULER=

# Absolute origin used to build agent-facing links (dashboard deep links in
# lead alerts, activation links). Falls back to https://lukkaplace.com.
PUBLIC_SITE_URL=https://lukkaplace.com
