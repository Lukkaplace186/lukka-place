node_modules/
.env
*.log
.DS_Store

# Deploy tarballs (services/postgres.js's documented tar/scp deploy flow
# produces these) and ad hoc terminal-output scratch dumps — build
# artifacts/local scratch, not source.
*.tar.gz
v*.txt

# Claude Code: settings.json (enabled plugins etc.) is shared project config
# and stays tracked; settings.local.json is per-machine permission state
# (WinGet paths, one-off script allowlists) — not meant to be shared.
.claude/settings.local.json

# Local SQLite database (plus WAL sidecar files)
lukka_place.db
lukka_place.db-shm
lukka_place.db-wal

# Downloaded listing photos (services/mediaStorage.js)
uploads/

# scripts/verify-pipeline.js scratch files
_verify.db
_verify.db-shm
_verify.db-wal
_verify_uploads/

# Design/reference scratch — not source (matches web/Design/, web/_ds/, etc.)
lukkaplace/
reference-portal/
*.zip
Design/
_ds/

# Claude Design canvas exports that land loose in web/ rather than under
# web/Design/ (the canvas HTML plus the runtime it loads). Nothing in the
# app imports any of them — verified by grep over web/app, web/components
# and web/lib — and web/support.js is the source of the only ESLint errors
# outside LocationAutocomplete.js. Real, served assets live in web/public/
# (e.g. public/assets/img/noimage.jpg, which lib/constants.js's NO_PHOTO_URL
# points at) and stay tracked; web/assets/ is the design's own source art.
*.dc.html
.thumbnail
web/support.js
web/image-slot.js
web/assets/
